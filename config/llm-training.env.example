# Optional process environment setting for the research-only CLI.
# Alternatively use --jobpilot-env with the existing JobPilot file;
# no secret copying is required. This file is not loaded automatically.
CRYPTOFORGE_OPENROUTER_API_KEY=
# Provider, fixed free model, request ledger and quota use CLI options.
# No paid fallback or trading credentials belong in this configuration.

# Operational database switched to local PostgreSQL on 2026-10-20.
# Approved exports must use the primary checkout's already-selected backend:
# CRYPTOFORGE_BACKEND=local
# CRYPTOFORGE_LOCAL_API_URL=http://127.0.0.1:54321
# Do not copy API/DB keys here. Offline research reads verified export files
# and established SQLite journals; worker namespaces cannot reach the database.
# This isolated worktree does not replace the primary backend deployment code.
