{
  "credentials_file": ".local/database/api-key",
  "database_writes_enabled": false,
  "feature_lookback_candles": 120,
  "horizon_candles": 3,
  "http_timeout_seconds": 3,
  "lookback_candles": 144,
  "maximum_body_bytes": 512000,
  "maximum_local_gets": 2,
