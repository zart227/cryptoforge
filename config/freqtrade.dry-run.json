{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "cryptoforge-dry-run",
  "initial_state": "running",
  "trading_mode": "spot",
  "margin_mode": "",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": true,
  "max_open_trades": 2,
  "stake_currency": "USDT",
  "stake_amount": 10,
  "tradable_balance_ratio": 0.99,
  "last_stake_amount_min_ratio": 0.5,
  "fiat_display_currency": "USD",
  "timeframe": "5m",
  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather",
  "db_url": "sqlite:////opt/cryptoforge/data/tradesv3.dry_run.sqlite",
  "exchange": {
    "name": "bybit",
    "key": "",
    "secret": "",
    "enable_ws": false,
    "ccxt_config": {
      "enableRateLimit": true
    },
    "ccxt_async_config": {
      "enableRateLimit": true
    },
    "pair_whitelist": [
      "BTC/USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_entry": "limit",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "internals": {
    "process_throttle_secs": 5
  }
}
