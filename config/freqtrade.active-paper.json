{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "cryptoforge-active-paper",
  "cancel_open_orders_on_exit": true,
  "db_url": "sqlite:///./data/live-pilot/tradesv3.paper.sqlite",
  "dry_run": true,
  "dry_run_wallet": 10.40884583,
  "entry_pricing": {
    "check_depth_of_market": {
      "bids_to_ask_delta": 1,
