  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "order_types": {
    "emergency_exit": "market",
    "entry": "limit",
    "exit": "limit",
    "force_entry": "limit",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "pairlists": [
    {
      "method": "VolumePairList",
      "number_assets": 30,
      "sort_key": "quoteVolume",
      "min_value": 500000,
      "refresh_period": 1800
