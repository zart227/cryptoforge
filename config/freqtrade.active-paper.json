    "price_side": "same",
    "use_order_book": true
  },
  "exchange": {
    "ccxt_async_config": {
      "enableRateLimit": true,
      "has": {
        "fetchCurrencies": false
      },
      "options": {
        "fetchCurrencies": false
      }
    },
    "ccxt_config": {
      "enableRateLimit": true,
      "has": {
        "fetchCurrencies": false
      },
      "options": {
        "fetchCurrencies": false
      }
    },
    "enable_ws": false,
    "key": "",
    "name": "bybit",
    "pair_blacklist": [
      "(USDC|USDE|DAI|FDUSD|TUSD|USDD|PYUSD|EUR|EURC)/USDT",
      ".*(3L|3S|5L|5S)/USDT"
    ],
    "pair_whitelist": [],
    "secret": ""
  },
  "exit_pricing": {
    "order_book_top": 1,
    "price_side": "same",
    "use_order_book": true
  },
  "fiat_display_currency": "USD",
  "force_entry_enable": false,
  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 5
  },
  "margin_mode": "",
