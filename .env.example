# CryptoForge environment template. Copy to .env locally and fill values.
# Never commit real credentials.

CRYPTOFORGE_ENV=development
CRYPTOFORGE_DRY_RUN=true

# Bybit Spot dry-run configuration.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Supabase server-side credentials.
# Explicit choice: supabase (default) or local. No automatic fallback or sync.
CRYPTOFORGE_BACKEND=supabase
# Local credentials are generated by scripts/database_backend.py init.
CRYPTOFORGE_LOCAL_API_URL=http://127.0.0.1:54321
CRYPTOFORGE_LOCAL_API_KEY_FILE=.local/database/api-key
CRYPTOFORGE_LOCAL_DB_URL_FILE=.local/database/freqtrade-url
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection URL from Supabase Connect (Session pooler). Keep private.
SUPABASE_DB_URL=

# Optional Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRYPTOFORGE_TELEGRAM_RELAY_STATE=./data/telegram-relay-state.json
CRYPTOFORGE_RELAY_TIMEOUT_SECONDS=10

# Optional TypeSafe/Jev document evaluation CLI.
TYPESAFE_API_KEY=

# Local state.
CRYPTOFORGE_DATA_DIR=./data
CRYPTOFORGE_OUTBOX_DB=./data/outbox.sqlite3
# Primary price diagnostics only; shared by executor, collector and health CLI.
# Bounded to 256..1024 MiB; the independent 2048 MiB disk reserve still applies.
CRYPTOFORGE_PRIMARY_FORECAST_MAXIMUM_MB=256
