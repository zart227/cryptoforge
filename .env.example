# CryptoForge environment template. Copy to .env locally and fill values.
# Never commit real credentials.

CRYPTOFORGE_ENV=development
CRYPTOFORGE_DRY_RUN=true

# Bybit Spot dry-run configuration.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Supabase server-side credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local state.
CRYPTOFORGE_DATA_DIR=./data
CRYPTOFORGE_OUTBOX_DB=./data/outbox.sqlite3
