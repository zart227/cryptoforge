# Copy this file to .env on the Windows machine and fill real values there.
# Never commit .env.

CRYPTOFORGE_ENV=local-docker
CRYPTOFORGE_DRY_RUN=true

# Bybit API key for the dedicated CryptoForge sub-account.
# Keep withdrawals disabled. Prefer Spot-only permissions if Bybit allows it.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Supabase server-side credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Telegram relay credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRYPTOFORGE_TELEGRAM_RELAY_STATE=/app/data/telegram-relay-state.json
CRYPTOFORGE_RELAY_TIMEOUT_SECONDS=10

# Optional ntfy fallback.
NTFY_TOPIC=
NTFY_BASE_URL=https://ntfy.sh

# Runtime cadence.
CRYPTOFORGE_MARKET_FEEDER_INTERVAL_SECONDS=120
CRYPTOFORGE_EXECUTOR_INTERVAL_SECONDS=120
CRYPTOFORGE_TELEGRAM_RELAY_INTERVAL_SECONDS=60
CRYPTOFORGE_NIGHT_RESEARCH_TIME=02:15

# Default is shadow mode because --live is intentionally absent.
# Add --live only after local smoke checks and after the VPS executor timer is disabled.
CRYPTOFORGE_LIVE_EXECUTOR_ARGS=--use-night-research --allow-intraday-reversion --append-fallback-pairs --pair ETH/USDT --pair NEAR/USDT --pair ENA/USDT --pair HYPE/USDT --stake-amount 5.5 --timeout 25
CRYPTOFORGE_NIGHT_RESEARCH_ARGS=--pair ETH/USDT --pair NEAR/USDT --pair ENA/USDT --pair HYPE/USDT --lookback-candles 240 --supabase-timeout 30
