[Unit]
Description=CryptoForge Freqtrade live Spot pilot
Documentation=https://www.freqtrade.io/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cryptoforge
Group=cryptoforge
WorkingDirectory=/opt/cryptoforge/app
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/cryptoforge/app/.env
ExecStart=/opt/cryptoforge/app/cryptoforge_repo/deploy/run_live_pilot.sh
KillSignal=SIGTERM
KillMode=mixed
SuccessExitStatus=130 143
TimeoutStartSec=360
TimeoutStopSec=90
Restart=no
Nice=5
CPUQuota=80%
MemoryMax=700M
MemoryHigh=620M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/cryptoforge

[Install]
WantedBy=multi-user.target
