[Unit]
Description=CryptoForge Supabase-backed live executor
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cryptoforge
Group=cryptoforge
WorkingDirectory=/opt/cryptoforge/app/cryptoforge_repo
Environment=PYTHONPATH=/opt/cryptoforge/app/cryptoforge_repo/src
EnvironmentFile=/opt/cryptoforge/app/.env
ExecStart=/opt/cryptoforge/app/venv/bin/python /opt/cryptoforge/app/cryptoforge_repo/scripts/run_supabase_live_executor.py --use-night-research --night-research-limit 8 --allow-intraday-reversion --allow-emerging-momentum --append-fallback-pairs --pair ETH/USDT --pair NEAR/USDT --pair ENA/USDT --pair HYPE/USDT --stake-amount 5.5 --ml-mode shadow --ml-threshold 0.55 --ml-max-age-hours 36 --live --timeout 25
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
